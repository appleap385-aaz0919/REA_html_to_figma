ary-lt d-flex align-items-center gap-2\">\n                            <h3 class=\"card-title mb-0\"><i class=\"ti ti-pencil me-1\"></i><span data-title-editor=\"\">문항 편집</span></h3>\n                            <span class=\"text-secondary small\" id=\"frameLoadTime\"></span>\n                            <select class=\"form-select form-select-sm w-auto\" id=\"frameHeightMode\">\n                                <option value=\"auto\">높이 자동(내용에 맞춤)</option>\n                                <option value=\"fixed\">높이 고정 640px(안에서 스크롤)</option>\n                            </select>\n                            <div class=\"ms-auto d-flex gap-1\">\n                                <button type=\"button\" class=\"btn btn-sm\" data-call=\"save\">save()</button>\n                                <button type=\"button\" class=\"btn btn-sm\" data-call=\"getDocument\">getDocument()</button>\n                                <button type=\"button\" class=\"btn btn-sm\" data-call=\"mcOn\">객관식 켜기</button>\n                                <button type=\"button\" class=\"btn btn-sm\" data-call=\"mcOff\">객관식 끄기</button>\n                                <button type=\"button\" class=\"btn btn-sm\" data-call=\"destroy\">destroy()</button>\n                            </div>\n                        </div>\n                        <div class=\"card-body\">\n                            <div id=\"frameEditorWrap\"></div>\n                        </div>\n                        <div class=\"card-footer\">\n                            <pre class=\"mb-0 small\" data-output=\"\">-</pre>\n                        </div>\n                    </div>\n                    <div class=\"card\">\n                        <div class=\"card-header bg-secondary-lt d-flex align-items-center gap-2\">\n                            <h3 class=\"card-title mb-0\"><i class=\"ti ti-help me-1\"></i><span data-title-viewer=\"\">문항</span></h3>\n                            <button type=\"button\" class=\"btn btn-sm ms-auto\" data-call=\"viewer\"><i class=\"ti ti-refresh me-1\"></i>미리보기 다시 그리기</button>\n                        </div>\n                        <div class=\"card-body\">\n                            <div id=\"frameViewerWrap\"></div>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n    </div>\n\n\n            </div>\n        </div>\n    </div>\n</div>\n\n\n    \n    <div>\n    <div class=\"modal modal-blur fade\" id=\"logoutConfirmModal\" tabindex=\"-1\" aria-hidden=\"true\">\n        <div class=\"modal-dialog modal-dialog-centered modal-sm\">\n            <div class=\"modal-content\">\n                <div class=\"modal-header bg-warning-lt\">\n                    <h5 class=\"modal-title\">\n                        <i class=\"ti me-2 ti-alert-triangle text-warning\"></i><span>로그아웃</span>\n                    </h5>\n                    <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"닫기\"></button>\n                </div>\n                <div class=\"modal-body\">\n                    <div class=\"fw-bold mb-3\"><div class=\"text-center\">로그아웃하시겠습니까?</div></div>\n                    <div id=\"logoutConfirmBody\" class=\"text-secondary text-center\">로그인 화면으로 나갑니다.</div>\n                </div>\n                <div class=\"modal-footer py-2\">\n                    <button type=\"button\" class=\"btn btn-sm\" data-bs-dismiss=\"modal\">취소</button>\n                    <button type=\"button\" class=\"btn btn-sm btn-warning\" data-action-ok=\"\">로그아웃</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n<!-- 토스트 팝업 -->\n\n\n\n<div id=\"loadingOverlay\" class=\"loading-overlay\">\n    <div class=\"spinner-border text-primary\" role=\"status\"></div>\n</div>\n\n<script src=\"/webjars/tabler__core/1.7.0/dist/js/tabler.min-17579e48ae4969feb55b54f2ad3563e3.js\"></script>\n<script src=\"/webjars/htmx.org/2.0.11/dist/htmx.min-3d6553be673509e52e526683624b4e2b.js\"></script>\n<script src=\"/webjars/tabler__core/1.7.0/dist/libs/litepicker/dist/litepicker-19693754a71f7d0ffb70fd7b2a1cade5.js\"></script>\n<script src=\"/js/common-8dc66a9d95b497a50939a25f89dee707.js\"></script>\n\n    \n    <script src=\"/js/vendor/donga-question-viewer/donga-question-viewer.min-1f8549449e8223caff4dcc003a92cf03.js\"></script>\n    <script>\n        (function () {\n            if (!window.DongaQuestionViewer) return;\n            var cdnBaseUrl = \"https:\\/\\/dev-items.douclass.com\\/itembank\";\n\n            // data-qv-layout=\"card\" 인 요소만 카드 레이아웃, 없으면 뷰어 기본\n            window.renderQuestionView = function (target, doc, layout) {\n                DongaQuestionViewer.render(target, doc, { imageBaseUrl: cdnBaseUrl, showAnswer: true, showExplanation: true, showModelAnswer: true, showGradingCriteria: true, layout: layout || undefined });\n            };\n            // renderPassage는 { passageContent } 플랫 객체를 받음. 본문은 지문 문서의 content.passageHtml\n            window.renderPassageView = function (target, doc) {\n                DongaQuestionViewer.renderPassage(target, { passageContent: (doc && doc.content && doc.content.passageHtml) || '' }, { imageBaseUrl: cdnBaseUrl });\n            };\n\n            document.querySelectorAll('.qv-item').forEach(function (item) {\n                var dataEl = item.querySelector('script[type=\"application/json\"]');\n                var target = item.querySelector('.qv-render');\n                if (!dataEl || !target) return;\n                try {\n                    window.renderQuestionView(target, JSON.parse(dataEl.textContent), item.getAttribute('data-qv-layout'));\n                } catch (e) {\n                    console.error('문항 렌더 실패', e);\n                }\n            });\n            document.querySelectorAll('.qv-passage').forEach(function (item) {\n                var dataEl = item.querySelector('script');\n                var target = item.querySelector('.qv-render');\n                if (!dataEl || !target) return;\n                try {\n                    window.renderPassageView(target, JSON.parse(dataEl.textContent));\n                } catch (e) {\n                    console.error('지문 렌더 실패', e);\n                }\n            });\n        })();\n    </script>\n\n    \n    <script src=\"/js/vendor/donga-question-editor/donga-question-editor.min-2da16fddbc2dd1522ca1b7947ea73f1e.js\"></script>\n    <script>\n        (function () {\n            if (!window.DongaQuestionEditor) return;\n            var cdnBaseUrl = \"https:\\/\\/dev-items.douclass.com\\/itembank\";\n            var fontsUrl = \"\\/js\\/vendor\\/mathlive\\/fonts\";\n\n            // 저장은 화면 버튼이 하므로 툴바 [저장]·튜닝 경고를 뺌(저장을 막는 오류는 그대로). 출력 모드는 제공처 지정 html-only. 폰트는 번들 옆 기본 위치 대신 vendor mathlive 폴더\n            window.createQuestionEditor = function (host, doc) {\n                return DongaQuestionEditor.create(host, doc, {\n                    outputProfile: 'html-only',\n                    imageBaseUrl: cdnBaseUrl,\n                    showSaveButton: false,\n                    showWarnings: false,\n                    math: { fontsUrl: fontsUrl }\n                });\n            };\n\n            // 화면 표시용 — 데이터 이상(JSON 파싱 · 번들 문서 검사 실패)이면 칸에 안내를 그리고 null. 저장 쪽 임시 편집기는 오류가 올라와야 저장을 막으므로 createQuestionEditor 를 그대로 씀\n            window.mountQuestionEditor = function (host, text, label) {\n                try {\n                    return window.createQuestionEditor(host, JSON.parse(text));\n                } catch (e) {\n                    console.error(label + ' 편집기 생성 실패', e);\n                    // 칸은 min-height 뿐이라 .empty 의 height 100% 가 안 먹음 — h-auto 로 풀고 flex 로 늘려 가운데\n                    host.classList.add('d-flex');\n                    host.innerHTML = '<div class=\"empty flex-fill h-auto\">'\n                        + '<div class=\"empty-icon h-auto\"><i class=\"ti ti-alert-triangle fs-1 text-secondary\"></i></div>'\n                        + '<p class=\"empty-title\">' + label + ' 데이터에 이상이 있어 편집기를 열 수 없습니다.</p>'\n                        + '</div>';\n                    return null;\n                }\n            };\n        })();\n    </script>\n\n    <script>\n        (function () {\n            const editorSrc = \"\\/js\\/vendor\\/donga-question-editor\\/donga-question-editor.min-2da16fddbc2dd1522ca1b7947ea73f1e.js\";\n            const viewerSrc = \"\\/js\\/vendor\\/donga-question-viewer\\/donga-question-viewer.min-1f8549449e8223caff4dcc003a92cf03.js\";\n            const cdnBaseUrl = \"https:\\/\\/dev-items.douclass.com\\/itembank\";\n            const fontsUrl = \"\\/js\\/vendor\\/mathlive\\/fonts\";\n            const input = document.getElementById('frameDocInput');\n            const heightMode = document.getElementById('frameHeightMode');\n            // pending = 아직 마운트 안 한 문서(탭 첫 표시 때 마운트), 마운트 뒤엔 null 이라 탭을 오가도 다시 안 그림\n            const sides = { direct: { editor: null, pending: null }, frame: { editor: null, pending: null } };\n            let editorFrame = null;\n            let editorObserver = null;\n            let viewerFrame = null;\n            let viewerReady = false;\n            let viewerPendingJson = null;\n\n            // iframe 문서 — Tabler · custom.css 없이 번들 하나만\n            function frameHtml(src) {\n                return '<!doctype html><html lang=\"ko\"><head><meta charset=\"utf-8\">'\n                    + '<style>html,body{margin:0;height:auto;background:#fff}body{display:flow-root}</style>'\n                    + '</head><body><div id=\"host\"></div><script src=\"' + src + '\"><' + '/script></body></html>';\n            }\n            function createFrame(src, onReady) {\n                const frame = document.createElement('iframe');\n                frame.style.cssText = 'display:block;width:100%;border:0;height:480px;';\n                frame.addEventListener('load', onReady, { once: true });\n                frame.srcdoc = frameHtml(src);\n                return frame;\n            }\n            // iframe 높이를 안 body 크기에 맞춤\n            function fitHeight(frame) {\n                const win = frame.contentWindow;\n                const fit = function () { frame.style.height = Math.ceil(win.document.body.scrollHeight) + 'px'; };\n                const observer = new win.ResizeObserver(fit);\n                observer.observe(win.document.body);\n                fit();\n                return observer;\n            }\n\n            function paneOf(side) {\n                return document.querySelector('[data-side=\"' + side + '\"]');\n            }\n            function output(side, label, value) {\n                const text = typeof value === 'string' ? value : JSON.stringify(value, null, 2);\n                paneOf(side).querySelector('[data-output]').textContent = label + '\\n' + text;\n            }\n            // 문서 전문은 길어 길이만\n            function docLength(doc) {\n                return doc ? JSON.stringify(doc).length : 0;\n            }\n            function summarizeSave(result) {\n                return {\n                    ok: result.ok,\n                    issues: (result.issues || []).map(function (issue) { return issue.code || issue.message || issue; }),\n                    documentLength: docLength(result.document)\n                };\n            }\n            function isPassage(doc) {\n                return !!(doc && doc.content && typeof doc.content.passageHtml === 'string');\n            }\n\n            function destroyEditor(side) {\n                if (sides[side].editor) sides[side].editor.destroy();\n                sides[side].editor = null;\n            }\n\n            // 기존 = 공통 fragment 그대로\n            function mountDirect(text) {\n                const host = document.getElementById('frameDirectEditor');\n                host.replaceChildren();\n                sides.direct.editor = window.createQuestionEditor(host, JSON.parse(text));\n                output('direct', '마운트', '완료');\n                renderViewer('direct');\n            }\n            function renderDirectViewer(doc) {\n                const target = document.getElementById('frameDirectViewer');\n                target.replaceChildren();\n                if (isPassage(doc)) window.renderPassageView(target, doc);\n                else window.renderQuestionView(target, doc, 'card');\n            }\n\n            // 높이 자동 = 안 body 추적, 고정 = 640px 에서 iframe 안 스크롤\n            function applyHeightMode() {\n                if (editorObserver) editorObserver.disconnect();\n                editorObserver = null;\n                if (!editorFrame || !sides.frame.editor) return;\n                if (heightMode.value === 'fixed') editorFrame.style.height = '640px';\n                else editorObserver = fitHeight(editorFrame);\n            }\n\n            // 옵션은 common/question-editor.html · question-viewer.html 과 같게. 문서는 iframe 쪽 JSON 으로 파싱(realm 맞춤)\n            function mountFrame(text) {\n                const started = performance.now();\n                editorFrame = createFrame(editorSrc, function () {\n                    const win = editorFrame.contentWindow;\n                    if (!win.DongaQuestionEditor) {\n                        output('frame', '마운트', '편집기 번들을 불러오지 못했습니다');\n                        return;\n                    }\n                    sides.frame.editor = win.DongaQuestionEditor.create(win.document.getElementById('host'), win.JSON.parse(text), {\n                        outputProfile: 'html-only',\n                        imageBaseUrl: cdnBaseUrl,\n                        showSaveButton: false,\n                        showWarnings: false,\n                        math: { fontsUrl: fontsUrl }\n                    });\n                    document.getElementById('frameLoadTime').textContent = '준비 ' + Math.round(performance.now() - started) + 'ms';\n                    applyHeightMode();\n                    output('frame', '마운트', '완료');\n                    renderViewer('frame');\n                });\n                document.getElementById('frameEditorWrap').replaceChildren(editorFrame);\n\n                viewerReady = false;\n                viewerFrame = createFrame(viewerSrc, function () {\n                    viewerReady = true;\n                    fitHeight(viewerFrame);\n                    if (viewerPendingJson !== null) drawFrameViewer();\n                });\n                document.getElementById('frameViewerWrap').replaceChildren(viewerFrame);\n            }\n            function drawFrameViewer() {\n                const win = viewerFrame.contentWindow;\n                const target = win.document.getElementById('host');\n                const doc = win.JSON.parse(viewerPendingJson);\n                viewerPendingJson = null;\n                target.replaceChildren();\n                if (!win.DongaQuestionViewer) {\n                    target.textContent = '뷰어 번들을 불러오지 못했습니다';\n                    return;\n                }\n                if (isPassage(doc)) {\n                    win.DongaQuestionViewer.renderPassage(target, { passageContent: doc.content.passageHtml || '' }, { imageBaseUrl: cdnBaseUrl });\n                } else {\n                    win.DongaQuestionViewer.render(target, doc, { imageBaseUrl: cdnBaseUrl, showAnswer: true, showExplanation: true, showModelAnswer: true, showGradingCriteria: true, layout: 'card' });\n                }\n            }\n\n            // 뷰어는 그 탭 편집기의 getDocument() 로 그림(편집기는 건드리지 않음)\n            function renderViewer(side) {\n                const editor = sides[side].editor;\n                if (!editor) {\n                    output(side, '미리보기', '편집기가 없습니다 — [불러오기] 먼저');\n                    return;\n                }\n                const doc = editor.getDocument();\n                if (!doc) {\n                    output(side, '미리보기', '문서를 만들지 못했습니다');\n                    return;\n                }\n                if (side === 'direct') {\n                    renderDirectViewer(doc);\n                    return;\n                }\n                viewerPendingJson = JSON.stringify(doc);\n                if (viewerReady) drawFrameViewer();\n            }\n\n            function mountPending(side) {\n                const text = sides[side].pending;\n                if (text === null) return;\n                sides[side].pending = null;\n                try {\n                    if (side === 'direct') mountDirect(text);\n                    else mountFrame(text);\n                } catch (e) {\n                    output(side, '마운트 예외', String(e));\n                    console.error(e);\n                }\n            }\n\n            // 두 탭을 처음 문서로 되돌림. 보이는 탭은 바로, 숨은 탭은 처음 보일 때 마운트(숨은 채 마운트하면 레이아웃이 어긋남)\n            document.getElementById('frameDocLoad').addEventListener('click', function () {\n                const text = input.value.trim();\n                let doc = null;\n                try {\n                    doc = JSON.parse(text);\n                } catch (e) {\n                    showToast('JSON 형식이 아닙니다', 'danger');\n                    return;\n                }\n                // 카드 제목을 문서 종류(문항 · 지문)에 맞춤\n                const passage = isPassage(doc);\n                document.querySelectorAll('[data-title-editor]').forEach(function (el) { el.textContent = passage ? '지문 편집' : '문항 편집'; });\n                document.querySelectorAll('[data-title-viewer]').forEach(function (el) { el.textContent = passage ? '지문' : '문항'; });\n                Object.keys(sides).forEach(function (side) {\n                    destroyEditor(side);\n                    sides[side].pending = text;\n                });\n                Object.keys(sides).forEach(function (side) {\n                    if (paneOf(side).classList.contains('active')) mountPending(side);\n                });\n            });\n\n            document.addEventListener('shown.bs.tab', function (e) {\n                const pane = document.querySelector(e.target.getAttribute('href'));\n                if (pane && pane.dataset.side) mountPending(pane.dataset.side);\n            });\n\n            document.getElementById('frameDocCompare').addEventListener('click', function () {\n                if (!sides.direct.editor || !sides.frame.editor) {\n                    showToast('두 탭을 한 번씩 열어 편집기를 띄우세요', 'warning');\n                    return;\n                }\n                const same = JSON.stringify(sides.direct.editor.getDocument()) === JSON.stringify(sides.frame.editor.getDocument());\n                showToast(same ? '두 문서가 같습니다' : '두 문서가 다릅니다', same ? 'success' : 'danger');\n            });\n\n            heightMode.addEventListener('change', applyHeightMode);\n\n            document.addEventListener('click', function (e) {\n                const button = e.target.closest('[data-call]');\n                if (!button) return;\n                const side = button.closest('[data-side]').dataset.side;\n                const call = button.dataset.call;\n                if (call === 'viewer') {\n                    renderViewer(side);\n                    return;\n                }\n                const editor = sides[side].editor;\n                if (!editor) {\n                    output(side, call, '편집기가 없습니다 — [불러오기] 먼저');\n                    return;\n                }\n                try {\n                    if (call === 'save') output(side, 'save()', summarizeSave(editor.save()));\n                    else if (call === 'getDocument') output(side, 'getDocument()', { documentLength: docLength(editor.getDocument()) });\n                    else if (call === 'mcOn') output(side, 'setMultipleChoice(true)', editor.setMultipleChoice(true));\n                    else if (call === 'mcOff') output(side, 'setMultipleChoice(false)', editor.setMultipleChoice(false));\n                    else if (call === 'destroy') {\n                        destroyEditor(side);\n                        output(side, 'destroy()', '완료');\n                    }\n                } catch (err) {\n                    output(side, call + ' 예외', String(err));\n                    console.error(err);\n                }\n            });\n        })();\n    </script>\n\n\n\n</body></html>",
