m-check-inline mb-0\">\n                            <input type=\"checkbox\" class=\"form-check-input\" data-check-group=\"cacheTarget\" data-label=\"사이트\" value=\"/cache/site-reload.donga\">\n                            <span class=\"form-check-label\">사이트</span>\n                        </label>\n                    </div>\n                </div>\n                <div class=\"modal-footer py-2\">\n                    <button type=\"button\" class=\"btn btn-sm\" data-bs-dismiss=\"modal\">취소</button>\n                    <button type=\"button\" class=\"btn btn-sm btn-primary\" data-action-ok=\"\">reload</button>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        (function () {\n            const modal = document.getElementById('cacheReloadModal');\n            const okButton = modal.querySelector('[data-action-ok]');\n            const all = modal.querySelector('[data-check-all=\"cacheTarget\"]');\n            const items = [...modal.querySelectorAll('[data-check-group=\"cacheTarget\"]')];\n\n            // 전체가 체크면 all-reload 한 번, 아니면 고른 대상마다 한 번\n            function selectedTargets() {\n                return all.checked ? [all] : items.filter(function (cb) { return cb.checked; });\n            }\n\n            modal.addEventListener('show.bs.modal', function () {\n                [all].concat(items).forEach(function (cb) { cb.checked = false; });\n                okButton.disabled = true;\n            });\n\n            // common.js 의 전체·개별 동기화(document change)가 끝난 뒤에 읽는다\n            modal.addEventListener('change', function () {\n                setTimeout(function () { okButton.disabled = selectedTargets().length === 0; });\n            });\n\n            okButton.addEventListener('click', function () {\n                const targets = selectedTargets();\n                const label = targets.map(function (cb) { return cb.dataset.label; }).join(' · ');\n                bootstrap.Modal.getInstance(modal).hide();\n                Promise.all(targets.map(function (cb) {\n                    return fetch(cb.value).then(function (res) { return res.ok; }).catch(function () { return false; });\n                })).then(function (results) {\n                    const ok = results.every(Boolean);\n                    showToast(label + ' 캐시 reload ' + (ok ? '완료' : '실패'), ok ? 'success' : 'danger');\n                });\n            });\n        })();\n    </script>\n\n    <div class=\"modal modal-blur fade\" id=\"sessionExpireModal\" tabindex=\"-1\" aria-hidden=\"true\">\n        <div class=\"modal-dialog modal-sm modal-dialog-centered\">\n            <div class=\"modal-content\">\n                <div class=\"modal-header\">\n                    <h5 class=\"modal-title\">역할별 로그아웃</h5>\n                    <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"닫기\"></button>\n                </div>\n                <div class=\"modal-body\">\n                    <div class=\"fw-bold\">로그아웃할 사이트 · 역할을 고르세요.</div>\n                    <div class=\"text-secondary small mb-3\">고른 사이트 세션만 끊기고, 본인 세션은 제외됩니다.</div>\n                    \n                        <label class=\"form-check\">\n                            <input type=\"checkbox\" class=\"form-check-input\" data-check-all=\"roleTarget\">\n                            <span class=\"form-check-label\">전체</span>\n                        </label>\n                        <label class=\"form-check\">\n                            <input type=\"checkbox\" class=\"form-check-input\" data-check-group=\"roleTarget\" value=\"MASTER:ADMIN\">\n                            <span class=\"form-check-label\">[MASTER] 관리자 (ADMIN)</span>\n                        </label><label class=\"form-check\">\n                            <input type=\"checkbox\" class=\"form-check-input\" data-check-group=\"roleTarget\" value=\"MASTER:USER\">\n                            <span class=\"form-check-label\">[MASTER] 사용자 (USER)</span>\n   