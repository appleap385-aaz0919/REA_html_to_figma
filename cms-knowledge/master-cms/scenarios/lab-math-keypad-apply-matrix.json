 {"label":"1615-lab-math-matrix-key","command":["eval","(() => {const d=window.MathFieldDialog.get();d.mf.value='';const b=[...d.backdrop.querySelectorAll('.keypad__key')].find(e=>e.getAttribute('aria-label')==='행렬');if(!b)throw Error('Matrix key missing');const r=b.getBoundingClientRect(),i={bubbles:true,pointerId:72,pointerType:'mouse',clientX:r.x+r.width/2,clientY:r.y+r.height/2};b.dispatchEvent(new PointerEvent('pointerdown',i));window.dispatchEvent(new PointerEvent('pointerup',i));return {action:'Press actual matrix keypad handlers',rows:d.matrix.rows.value,cols:d.matrix.cols.value};})()"]},
