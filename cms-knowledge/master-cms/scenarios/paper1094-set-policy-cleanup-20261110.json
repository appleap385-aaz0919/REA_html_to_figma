 {"label":"3042-own-paper1094-cleanup-modify-open","command":["eval","(()=>{if(new URLSearchParams(location.search).get('paperId')!=='1094'||location.pathname!=='/paper/detail.donga')throw Error('Own paper detail');const a=[...document.querySelectorAll('a[href]')].find(e=>{const u=new URL(e.href);return u.pathname==='/paper/modify.donga'&&u.searchParams.get('paperId')==='1094';});if(!a)throw Error('Modify missing');a.click();return {clicked:true};})()"]},
 {"label":"3043-own-paper1094-cleanup-set-remove-dialog","command":["eval","(()=>{const f=document.querySelector('#paperModifyForm');if(f.querySelector('[name=paperId]').value!=='1094'||[...f.querySelectorAll('[name=itemIds]')].map(e=>e.value).join(',')!=='2089238,2089242,2089243,2089244,2089245')throw Error('Expected saved five');const g=document.querySelector('#paperItemTable>tbody[data-passage-id=\"2089241\"]');if(!g||g.querySelector('[data-remove-group]').disabled)throw Error('Set missing');g.querySelector('[data-remove-group]').click();return {clicked:true};})()"]},
