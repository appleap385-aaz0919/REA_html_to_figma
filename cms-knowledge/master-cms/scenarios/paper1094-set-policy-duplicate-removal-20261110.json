 {"label":"3017-own-paper1094-duplicate-modal-open","command":["eval","(()=>{if(new URLSearchParams(location.search).get('paperId')!=='1094')throw Error('Own paper only');document.querySelector('[data-bs-target=\"#paperItemAddModal\"]').click();return {clicked:true};})()"]},
