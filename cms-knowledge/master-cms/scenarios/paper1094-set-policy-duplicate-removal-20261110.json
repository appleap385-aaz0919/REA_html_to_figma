 {"label":"3021-own-paper1094-remove-set-dialog-open","command":["eval","(()=>{const f=document.querySelector('#paperModifyForm');if(f.querySelector('[name=paperId]').value!=='1094')throw Error('Own paper');const g=document.querySelector('#paperItemTable>tbody[data-passage-id=\"2089241\"]');if(!g||g.querySelectorAll('tr[data-item-id]').length!==4)throw Error('Expected set group');const b=g.querySelector('[data-remove-group]');if(b.disabled)throw Error('Unexpected lock');b.click();return {groupCount:document.querySelectorAll('#paperItemTable>tbody').length,removeButtonsInSet:g.querySelectorAll('[data-remove-group]').length,perRowActionCounts:[...g.querySelectorAll('tr')].map(r=>r.querySelectorAll('button').length)};})()"]},
