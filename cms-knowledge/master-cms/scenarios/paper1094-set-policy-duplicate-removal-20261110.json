 {"label":"3023-own-paper1094-remove-set-dialog-cancel","command":["eval","(()=>{const m=document.querySelector('#removeGroupModal');if(!m.classList.contains('show'))throw Error('Expected modal');m.querySelector('.modal-footer [data-bs-dismiss=modal]').click();return {clicked:true};})()"]},
