{"steps":[
 {"label":"3078-own-disposable387-status-unlock","command":["eval","(()=>{if(new URLSearchParams(location.search).get('itemId')!=='2089387'||location.pathname!=='/item/all/detail.donga')throw Error('Disposable only');const f=document.querySelector('#statusForm'),b=document.querySelector('[data-status-edit]');if(f.elements.itemId.value!=='2089387'||f.querySelector('[name=viewFlag]:checked')?.value!=='R'||b.disabled||!document.querySelector('#statusFields').disabled)throw Error('Exact R baseline');b.click();return {unlocked:!document.querySelector('#statusFields').disabled};})()"]},
 {"label":"3079-own-disposable387-select-D-local","command":["eval","(()=>{const f=document.querySelector('#statusForm'),d=f.querySelector('[name=viewFlag][value=D]');if(f.elements.itemId.value!=='2089387'||document.querySelector('#statusFields').disabled||d.matches(':disabled')||f.querySelector('[name=viewFlag]:checked')?.value!=='R')throw Error('Normal D option required');d.click();return {selected:f.querySelector('[name=viewFlag]:checked')?.value};})()"]},
 {"label":"3080-own-disposable387-open-discard-confirm","command":["eval","(()=>{const f=document.querySelector('#statusForm'),b=document.querySelector('[data-status-save]');if(f.elements.itemId.value!=='2089387'||f.querySelector('[name=viewFlag]:checked')?.value!=='D'||document.querySelector('.modal.show')||b.matches(':disabled'))throw Error('Exact disposable D form');b.click();return {clicked:true};})()"]},
 {"label":"3081-own-disposable387-discard-confirm-read","command":["eval","(()=>{const m=document.querySelector('#statusDiscardModal');return {visible:m.classList.contains('show'),transitioning:bootstrap.Modal.getInstance(m)?._isTransitioning,text:m.innerText,formFields:[...document.querySelectorAll('#statusForm input')].filter(e=>!/token|csrf/i.test(e.name)).map(e=>({name:e.name,value:e.value,checked:e.checked,disabled:e.matches(':disabled')}))};})()"]}
],"tailChars":120}
